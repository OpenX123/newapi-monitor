# NewAPI 连接配置
NEWAPI_BASE_URL=https://your-newapi-domain.com
NEWAPI_ACCESS_TOKEN=your_access_token_here
NEWAPI_USER_ID=1

# PostgreSQL 数据库连接（直连 NewAPI 的数据库）
DATABASE_URL=postgres://user:password@localhost:5432/newapi

# 监控配置
DAILY_LIMIT=2000
# 计费单位换算：多少 quota = $1（对应 NewAPI 的 QuotaPerUnit），面板按美元展示
QUOTA_PER_UNIT=500000
POLL_INTERVAL=300000
PORT=3456

# Redis 缓存（可选，推荐）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=newapi-monitor
CACHE_TTL_SECONDS=120

# 面板访问密钥（可选；设置后访问面板需要先登录）
DASHBOARD_ACCESS_KEY=change_to_a_long_random_secret

# 实时推送：SSE 检查新日志的间隔（毫秒），无人订阅时不查库
REALTIME_INTERVAL_MS=5000

# ===== 实时风控规则（都可以在面板「设置」里改）=====
RULE_ENABLED=true
RULE_INTERVAL_MS=60000        # 规则检查间隔，与面板是否打开无关
SURGE_WINDOW_MIN=5            # 滑动窗口长度（分钟），所有规则都基于「最近 N 分钟」
SURGE_CALLS=300               # 窗口内调用数绝对阈值
SURGE_RATIO=5                 # 相对上一窗口放大多少倍算突增
SURGE_MIN_CALLS=30            # 倍数规则的最低调用数，避免 1→5 误报
SURGE_COST_USD=5              # 窗口内费用阈值（美元），告警会折算成 $/小时
SHARE_IP_PER_TOKEN=4          # 单 Token 窗口内 IP 数超过即疑似共享
SHARE_USERS_PER_IP=2          # 单 IP 窗口内账号数超过即告警
ALERT_COOLDOWN_MIN=30         # 同一对象同类告警的冷却时间（分钟）

# ===== 通知渠道（都可以在面板「设置」里改，保存后立即生效，无需重启）=====
# SMTP 邮件通知（可选）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_password
# 发件人显示名，留空则用 SMTP_USER
SMTP_FROM="NewAPI Monitor" <your_email@qq.com>

# 飞书自定义机器人（可选）：群设置 → 群机器人 → 添加自定义机器人
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人安全设置勾选「签名校验」时才需要
FEISHU_SECRET=

# 检测到脚本/自动化行为时是否推送告警
NOTIFY_SCRIPT=true

# ===== 处置策略 =====
# notify_only（默认，只告警）| auto（告警并调用 NewAPI 真正禁用 Token）
DISABLE_POLICY=notify_only
# 脚本行为是否也自动禁用（需 DISABLE_POLICY=auto）
DISABLE_ON_SCRIPT=false

# 订阅余量低于此百分比时提醒续费，0 表示关闭
SUBSCRIPTION_ALERT_PCT=20

# 报错分析明细的行数上限（兜底，正常量级远低于此值）
ERROR_ROWS_LIMIT=200000
