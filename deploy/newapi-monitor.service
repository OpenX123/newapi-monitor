[Unit]
Description=NewAPI Monitor
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/newapi-monitor
EnvironmentFile=-/root/newapi-monitor/.env
ExecStart=/root/newapi-monitor/run-native.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
